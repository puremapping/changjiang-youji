[
 {
  "id": "int-001",
  "source_table": "events",
  "source_id": "RSC-014",
  "target_person_id": "p-su-shi",
  "target_name": "蘇軾",
  "relation": "纪其遗迹",
  "quote": "蓋葬師云：「駝負重則行遠也。」然東坡先生樂府固已云：「誰似臨平山上塔，亭亭，迎客西來送客行。」則臨平有塔亦久矣。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": "「東坡」此處為黃州地名（蘇軾舊居），紀其遺跡"
 },
 {
  "id": "int-002",
  "source_table": "events",
  "source_id": "RSC-028",
  "target_person_id": "p-li-bai",
  "target_name": "李白",
  "relation": "追慕",
  "quote": "」過新豐，小憩。李太白詩云：「南國新豐酒，東山小妓歌。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-003",
  "source_table": "events",
  "source_id": "RSC-045",
  "target_person_id": "p-li-bai",
  "target_name": "李白",
  "relation": "追慕",
  "quote": "李太白詩云「維舟至長蘆，目送煙雲高」是也。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-004",
  "source_table": "events",
  "source_id": "RSC-050",
  "target_person_id": "p-li-bai",
  "target_name": "李白",
  "relation": "纪其遗迹",
  "quote": "保寧有鳳凰臺、攬輝亭，臺有李太白詩云：「三山半落青天外，二水中分白鷺洲。」今已廢為大軍甲仗庫，惟亭因舊址重築，亦頗宏壯。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-005",
  "source_table": "events",
  "source_id": "RSC-050",
  "target_person_id": "p-li-bai",
  "target_name": "李白",
  "relation": "追慕",
  "quote": "有閣，因岡阜，其高十丈，李太白所謂「鍾山對北戶，淮水入南榮」者，又《橫江詞》「一風三日吹倒山，白浪高於瓦棺閣」是也。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-006",
  "source_table": "events",
  "source_id": "RSC-052",
  "target_person_id": "p-li-bai",
  "target_name": "李白",
  "relation": "纪其遗迹",
  "quote": "謝玄暉登三山還望京邑，李太白登三山望金陵，皆有詩。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-007",
  "source_table": "events",
  "source_id": "RSC-054",
  "target_person_id": "p-li-bai",
  "target_name": "李白",
  "relation": "考订",
  "quote": "李太白集有《姑熟十詠》，予族伯父彥遠嘗言，東坡自黃州還，過當塗，讀之撫手大笑曰：「贋物敗矣，豈有李白作此語者！」郭功父爭以為不然，東坡又笑曰：「但恐是太白後身所作耳！」功父甚慍。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-008",
  "source_table": "events",
  "source_id": "RSC-054",
  "target_person_id": "p-li-bai",
  "target_name": "李白",
  "relation": "考订",
  "quote": "李太白集有《姑熟十詠》，予族伯父彥遠嘗言，東坡自黃州還，過當塗，讀之撫手大笑曰：「贋物敗矣，豈有李白作此語者！」郭功父爭以為不然，東坡又笑曰：「但恐是太白後身所作耳！」功父甚慍。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-009",
  "source_table": "events",
  "source_id": "RSC-054",
  "target_person_id": "p-li-bai",
  "target_name": "李白",
  "relation": "追慕",
  "quote": "蓋功父少時，詩句俊逸，前輩或許之，以為太白後身，功父亦遂以自負，故東坡因是戲之。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-010",
  "source_table": "events",
  "source_id": "RSC-054",
  "target_person_id": "p-li-bai",
  "target_name": "李白",
  "relation": "纪其遗迹",
  "quote": "或曰《十詠》及《歸來乎》、《笑矣乎》、《僧伽歌》、《懷素草書歌》，太白舊集本無之，宋次道再編時，貪多務得之過也。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-011",
  "source_table": "events",
  "source_id": "RSC-054",
  "target_person_id": "p-su-shi",
  "target_name": "蘇軾",
  "relation": "考订",
  "quote": "李太白集有《姑熟十詠》，予族伯父彥遠嘗言，東坡自黃州還，過當塗，讀之撫手大笑曰：「贋物敗矣，豈有李白作此語者！」郭功父爭以為不然，東坡又笑曰：「但恐是太白後身所作耳！」功父甚慍。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": "「東坡」此處為黃州地名（蘇軾舊居），紀其遺跡"
 },
 {
  "id": "int-012",
  "source_table": "events",
  "source_id": "RSC-054",
  "target_person_id": "p-su-shi",
  "target_name": "蘇軾",
  "relation": "考订",
  "quote": "李太白集有《姑熟十詠》，予族伯父彥遠嘗言，東坡自黃州還，過當塗，讀之撫手大笑曰：「贋物敗矣，豈有李白作此語者！」郭功父爭以為不然，東坡又笑曰：「但恐是太白後身所作耳！」功父甚慍。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": "「東坡」此處為黃州地名（蘇軾舊居），紀其遺跡"
 },
 {
  "id": "int-013",
  "source_table": "events",
  "source_id": "RSC-054",
  "target_person_id": "p-su-shi",
  "target_name": "蘇軾",
  "relation": "追慕",
  "quote": "蓋功父少時，詩句俊逸，前輩或許之，以為太白後身，功父亦遂以自負，故東坡因是戲之。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": "「東坡」此處為黃州地名（蘇軾舊居），紀其遺跡"
 },
 {
  "id": "int-014",
  "source_table": "events",
  "source_id": "RSC-056",
  "target_person_id": "p-li-bai",
  "target_name": "李白",
  "relation": "纪其遗迹",
  "quote": "蓋自絕江至和州，財十餘里，李太白有《黃出凌歊臺送族弟泛舟赴華陰》詩，即此地也。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-015",
  "source_table": "events",
  "source_id": "RSC-057",
  "target_person_id": "p-su-shi",
  "target_name": "蘇軾",
  "relation": "追慕",
  "quote": "是夜，月白如晝，影入溪中，搖蕩如玉塔，始知東坡「玉塔臥微欄」之句為妙也。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": "「東坡」此處為黃州地名（蘇軾舊居），紀其遺跡"
 },
 {
  "id": "int-016",
  "source_table": "events",
  "source_id": "RSC-058",
  "target_person_id": "p-li-bai",
  "target_name": "李白",
  "relation": "纪其遗迹",
  "quote": "郡集於青山李太白祠堂，二教授同集。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-017",
  "source_table": "events",
  "source_id": "RSC-058",
  "target_person_id": "p-li-bai",
  "target_name": "李白",
  "relation": "追慕",
  "quote": "太白烏巾，白衣錦袍。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-018",
  "source_table": "events",
  "source_id": "RSC-059",
  "target_person_id": "p-li-bai",
  "target_name": "李白",
  "relation": "追慕",
  "quote": "李太白詩云：「兩岸青山相對出，孤帆一片日邊來。」王文公詩云：「崔嵬天門山，江水遶其下。」梅聖俞云：「東梁如仰蠶，西梁如浮魚。」徐師川云：「南人北人朝暮船，東梁西梁今古山。」皆得句於此也。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-019",
  "source_table": "events",
  "source_id": "RSC-062",
  "target_person_id": "p-li-bai",
  "target_name": "李白",
  "relation": "追慕",
  "quote": "太白所謂「我愛銅官樂，千年未擬還」是也，恨不一到。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-020",
  "source_table": "events",
  "source_id": "RSC-064",
  "target_person_id": "p-li-bai",
  "target_name": "李白",
  "relation": "追慕",
  "quote": "九華本名九子，李太白為易名。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-021",
  "source_table": "events",
  "source_id": "RSC-064",
  "target_person_id": "p-li-bai",
  "target_name": "李白",
  "relation": "纪其遗迹",
  "quote": "太白與劉夢得皆有詩，而劉至以為可兼太華、女几之奇秀。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-022",
  "source_table": "events",
  "source_id": "RSC-065",
  "target_person_id": "p-li-bai",
  "target_name": "李白",
  "relation": "追慕",
  "quote": "李太白往來江東，此州所賦尤多，如《秋浦歌》十七首及《九華山》、《青溪》、《白笴陂》、《玉鏡潭》諸詩是也。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-023",
  "source_table": "events",
  "source_id": "RSC-065",
  "target_person_id": "p-li-bai",
  "target_name": "李白",
  "relation": "考订",
  "quote": "然觀太白此歌，高妙乃爾，則知《姑熟十詠》決為贋作也。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-024",
  "source_table": "events",
  "source_id": "RSC-065",
  "target_person_id": "p-li-bai",
  "target_name": "李白",
  "relation": "追慕",
  "quote": "杜牧之池州諸詩正爾，觀之亦清婉可愛，若與太白詩竝讀，醇醨異味矣。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-025",
  "source_table": "events",
  "source_id": "RSC-067",
  "target_person_id": "p-li-bai",
  "target_name": "李白",
  "relation": "追慕",
  "quote": "李太白《江上贈竇長史》詩云：「萬里南遷夜郎國，三年歸及長風沙。」梅聖俞《送方進士遊廬山》云：「長風沙浪屋許大，羅剎石齒水下排。歷此二險過湓浦，始見瀑布懸蒼崖。」即此地也。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-026",
  "source_table": "events",
  "source_id": "RSC-067",
  "target_person_id": "p-li-bai",
  "target_name": "李白",
  "relation": "追慕",
  "quote": "又太白《長干行》云：「早晚下三巴，預將書報家。相迎不道遠，直到長風沙。」蓋自金陵至此七百里，而室家來迎其夫，甚言其遠也。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-027",
  "source_table": "events",
  "source_id": "RSC-068",
  "target_person_id": "p-li-bai",
  "target_name": "李白",
  "relation": "追慕",
  "quote": "太白《江上望皖公山》詩云：「巉絕稱人意。」「巉絕」二字，不刊之妙也。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-028",
  "source_table": "events",
  "source_id": "RSC-072",
  "target_person_id": "p-li-bai",
  "target_name": "李白",
  "relation": "追慕",
  "quote": "泛彭蠡口，四望無際，乃知太白「開帆入天鏡」之句為妙。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-029",
  "source_table": "events",
  "source_id": "RSC-072",
  "target_person_id": "p-su-shi",
  "target_name": "蘇軾",
  "relation": "追慕",
  "quote": "岸土赤而壁立，東坡先生所謂「舟人指點岸如赬」者也。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": "「東坡」此處為黃州地名（蘇軾舊居），紀其遺跡"
 },
 {
  "id": "int-030",
  "source_table": "events",
  "source_id": "RSC-074",
  "target_person_id": "p-li-bai",
  "target_name": "李白",
  "relation": "追慕",
  "quote": "遊天慶觀，李太白詩所謂「潯陽紫極宮」也。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-031",
  "source_table": "events",
  "source_id": "RSC-074",
  "target_person_id": "p-li-bai",
  "target_name": "李白",
  "relation": "追慕",
  "quote": "太白詩有一石，亦近時俗書。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-032",
  "source_table": "events",
  "source_id": "RSC-075",
  "target_person_id": "p-bai-juyi",
  "target_name": "白居易",
  "relation": "追慕",
  "quote": "然白樂天詩固已云：「潯陽欲到思無窮，庾亮樓南湓口東。」則承誤亦久矣。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-033",
  "source_table": "events",
  "source_id": "RSC-079",
  "target_person_id": "p-yu-yan",
  "target_name": "顏真卿",
  "relation": "追慕",
  "quote": "唐碑亦甚多，惟顏魯公題名，最為時所傳。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-034",
  "source_table": "events",
  "source_id": "RSC-079",
  "target_person_id": "p-yu-yan",
  "target_name": "顏真卿",
  "relation": "追慕",
  "quote": "西林亦有顏魯公題名，書家以為二林題名，顏書之冠冕也。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-035",
  "source_table": "events",
  "source_id": "RSC-086",
  "target_person_id": "p-li-bai",
  "target_name": "李白",
  "relation": "追慕",
  "quote": "李太白《送弟之江東》云：「西塞當中路，南風欲進船。」必在荊楚作，故有中路之句。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-036",
  "source_table": "events",
  "source_id": "RSC-087",
  "target_person_id": "p-su-shi",
  "target_name": "蘇軾",
  "relation": "纪其遗迹",
  "quote": "過蘭溪，東坡先生所謂「山下蘭芽短浸谿」者。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": "「東坡」此處為黃州地名（蘇軾舊居），紀其遺跡"
 },
 {
  "id": "int-037",
  "source_table": "events",
  "source_id": "RSC-087",
  "target_person_id": "p-su-shi",
  "target_name": "蘇軾",
  "relation": "纪其遗迹",
  "quote": "蘇黃門謪高安，東坡先生送至巴河，即此地也。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": "「東坡」此處為黃州地名（蘇軾舊居），紀其遺跡"
 },
 {
  "id": "int-038",
  "source_table": "events",
  "source_id": "RSC-088",
  "target_person_id": "p-su-shi",
  "target_name": "蘇軾",
  "relation": "追慕",
  "quote": "然自牧之、王元之出守，又東坡先生、張文潛謫居，進為名邦。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": "「東坡」此處為黃州地名（蘇軾舊居），紀其遺跡"
 },
 {
  "id": "int-039",
  "source_table": "events",
  "source_id": "RSC-088",
  "target_person_id": "p-su-shi",
  "target_name": "蘇軾",
  "relation": "纪其遗迹",
  "quote": "泊臨皐亭，東坡先生所嘗寓，與秦少游書所謂「門外數步即大江」是也。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": "「東坡」此處為黃州地名（蘇軾舊居），紀其遺跡"
 },
 {
  "id": "int-040",
  "source_table": "events",
  "source_id": "RSC-088",
  "target_person_id": "p-su-shi",
  "target_name": "蘇軾",
  "relation": "追慕",
  "quote": "黃州與樊口正相對，東坡所謂「武昌樊口幽絕處」也。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": "「東坡」此處為黃州地名（蘇軾舊居），紀其遺跡"
 },
 {
  "id": "int-041",
  "source_table": "events",
  "source_id": "RSC-089",
  "target_person_id": "p-li-bai",
  "target_name": "李白",
  "relation": "追慕",
  "quote": "李太白《赤壁歌》云：「烈火張天照雲海，周瑜於此敗曹公。」不指言在黃州。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-042",
  "source_table": "events",
  "source_id": "RSC-089",
  "target_person_id": "p-su-shi",
  "target_name": "蘇軾",
  "relation": "纪其遗迹",
  "quote": "早，游東坡。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": "「東坡」此處為黃州地名（蘇軾舊居），紀其遺跡"
 },
 {
  "id": "int-043",
  "source_table": "events",
  "source_id": "RSC-089",
  "target_person_id": "p-su-shi",
  "target_name": "蘇軾",
  "relation": "纪其遗迹",
  "quote": "自州門而東，岡壟高下，至東坡，則地勢平曠開豁。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": "「東坡」此處為黃州地名（蘇軾舊居），紀其遺跡"
 },
 {
  "id": "int-044",
  "source_table": "events",
  "source_id": "RSC-090",
  "target_person_id": "p-su-shi",
  "target_name": "蘇軾",
  "relation": "追慕",
  "quote": "多奇石，五色錯雜，粲然可愛，東坡先生怪石供是也。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": "「東坡」此處為黃州地名（蘇軾舊居），紀其遺跡"
 },
 {
  "id": "int-045",
  "source_table": "events",
  "source_id": "RSC-093",
  "target_person_id": "p-li-bai",
  "target_name": "李白",
  "relation": "追慕",
  "quote": "李太白《贈江夏韋太守》詩云：「萬舸此中來，連帆過揚州。」蓋此郡自唐為衝要之地。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-046",
  "source_table": "events",
  "source_id": "RSC-096",
  "target_person_id": "p-li-bai",
  "target_name": "李白",
  "relation": "追慕",
  "quote": "李太白《江夏贈韋南陵》詩云：「頭陁雲外多僧氣。」正謂此寺也。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-047",
  "source_table": "events",
  "source_id": "RSC-096",
  "target_person_id": "p-huang-ti",
  "target_name": "黃庭堅",
  "relation": "追慕",
  "quote": "黃魯直亦云：「頭阤全盛時，宮殿梯空級。」藏殿後有南齊王簡棲碑，唐開元六年建。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-048",
  "source_table": "events",
  "source_id": "RSC-097",
  "target_person_id": "p-huang-ti",
  "target_name": "黃庭堅",
  "relation": "追慕",
  "quote": "鄂州樓觀為多，而此獨得江山之要會，山谷所謂「江東湖北行畫圖，鄂州南樓天下無」是也。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-049",
  "source_table": "events",
  "source_id": "RSC-097",
  "target_person_id": "p-huang-ti",
  "target_name": "黃庭堅",
  "relation": "追慕",
  "quote": "山谷云「凭欄十里芰荷香」，謂南湖也。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-050",
  "source_table": "events",
  "source_id": "RSC-098",
  "target_person_id": "p-li-bai",
  "target_name": "李白",
  "relation": "追慕",
  "quote": "唐沔州治漢陽縣，故李太白《沔州泛城南郎官湖詩》序云：「白遷於夜郎，遇故人尚書郎張謂出使夏口，沔州牧杜公、漢陽令王公觴於江城之南湖。」其後沔州廢，漢陽以縣隸鄂州。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-051",
  "source_table": "events",
  "source_id": "RSC-098",
  "target_person_id": "p-li-bai",
  "target_name": "李白",
  "relation": "追慕",
  "quote": "太白詩云：「誰道此水廣，狹如一疋練。江夏黃鶴樓，青山漢陽縣。大語猶可聞，故人難可見。」形容最妙。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-052",
  "source_table": "events",
  "source_id": "RSC-098",
  "target_person_id": "p-li-bai",
  "target_name": "李白",
  "relation": "追慕",
  "quote": "崔灝詩最傳，而太白奇句，得於此者尤多。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-053",
  "source_table": "events",
  "source_id": "RSC-098",
  "target_person_id": "p-li-bai",
  "target_name": "李白",
  "relation": "考订",
  "quote": "太白登此樓，《送孟浩然》詩云：「孤帆遠映碧山盡，惟見長江天際流。」蓋帆檣映遠山，尤可觀，非江行久，不能知也。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-054",
  "source_table": "events",
  "source_id": "RSC-098",
  "target_person_id": "p-li-bai",
  "target_name": "李白",
  "relation": "追慕",
  "quote": "初不云所遇何人，且太白固已云：「頗聞列仙人，於此學飛術。一朝向蓬海，千載空石室。」今鄂人謂之呂公洞，蓋流俗附會也。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-055",
  "source_table": "events",
  "source_id": "RSC-098",
  "target_person_id": "p-huang-ti",
  "target_name": "黃庭堅",
  "relation": "追慕",
  "quote": "黃魯直「宵征江夏縣，睡起漢陽城」，亦此意。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-056",
  "source_table": "events",
  "source_id": "RSC-098",
  "target_person_id": "p-su-shi",
  "target_name": "蘇軾",
  "relation": "追慕",
  "quote": "東坡先生有詩紀其事。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": "「東坡」此處為黃州地名（蘇軾舊居），紀其遺跡"
 },
 {
  "id": "int-057",
  "source_table": "events",
  "source_id": "RSC-100",
  "target_person_id": "p-li-bai",
  "target_name": "李白",
  "relation": "追慕",
  "quote": "洲蓋禰正平被殺處，故太白詩云：「至今芳洲上，蘭蕙不敢生。」梁王僧辯擊邵陵王綸軍至鸚鵡洲，即此地也。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-058",
  "source_table": "events",
  "source_id": "RSC-100",
  "target_person_id": "p-li-bai",
  "target_name": "李白",
  "relation": "追慕",
  "quote": "水色澄澈可鑑，太白云「楚水清若空」，蓋言此也。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-059",
  "source_table": "events",
  "source_id": "RSC-111",
  "target_person_id": "p-li-bai",
  "target_name": "李白",
  "relation": "追慕",
  "quote": "太白詩：「山隨平野盡，江入大荒流。」蓋荊渚所作也。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-060",
  "source_table": "events",
  "source_id": "RSC-112",
  "target_person_id": "p-du-fu",
  "target_name": "杜甫",
  "relation": "追慕",
  "quote": "杜子美有《送石首薛明府》詩，即此邑也。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-061",
  "source_table": "events",
  "source_id": "RSC-132",
  "target_person_id": "p-li-bai",
  "target_name": "李白",
  "relation": "纪其遗迹",
  "quote": "與兒輩登隄觀蜀江，乃知李太白《荊門望蜀江》詩「江色綠且明」為善狀物也。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-062",
  "source_table": "events",
  "source_id": "RSC-134",
  "target_person_id": "p-su-shi",
  "target_name": "蘇軾",
  "relation": "追慕",
  "quote": "子高即天覺，丹元子即東坡先生與之醻唱者。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": "「東坡」此處為黃州地名（蘇軾舊居），紀其遺跡"
 },
 {
  "id": "int-063",
  "source_table": "events",
  "source_id": "RSC-135",
  "target_person_id": "p-huang-ti",
  "target_name": "黃庭堅",
  "relation": "纪其遗迹",
  "quote": "《至喜亭記》，歐陽公撰，黃魯直書。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-064",
  "source_table": "events",
  "source_id": "RSC-137",
  "target_person_id": "p-huang-ti",
  "target_name": "黃庭堅",
  "relation": "纪其遗迹",
  "quote": "洞外溪上又有一崩石偃仆，刻云：「黃庭堅、弟叔向、子相、姪檠同道人唐履來游，觀辛亥舊題，如夢中事也。建中靖國元年三月庚寅。」按魯直初謫黔南，以紹聖二年過此，歲在乙亥，今云辛亥者誤也。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-065",
  "source_table": "events",
  "source_id": "RSC-140",
  "target_person_id": "p-li-bai",
  "target_name": "李白",
  "relation": "追慕",
  "quote": "太白詩云：「三朝上黃牛，三暮行太遲。三朝又三暮，不覺鬢成絲。」歐陽公云：「朝朝暮暮見黃牛，徒使行人過此愁。山高更遠望猶見，不是黃牛滯客舟。」蓋諺謂：「朝見黃牛，暮見黃牛。三朝三暮，黃牛如故。」故二公皆及之。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-066",
  "source_table": "events",
  "source_id": "RSC-145",
  "target_person_id": "p-huang-ti",
  "target_name": "黃庭堅",
  "relation": "追慕",
  "quote": "隔江有楚王城，亦山谷間，然地比歸州差平。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-067",
  "source_table": "events",
  "source_id": "RSC-153",
  "target_person_id": "p-huang-ti",
  "target_name": "黃庭堅",
  "relation": "追慕",
  "quote": "黃魯直詩云：「一百八盤攜手上，至今歸夢饒羊腸。」即謂此也。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-068",
  "source_table": "events",
  "source_id": "RSC-155",
  "target_person_id": "p-huang-ti",
  "target_name": "黃庭堅",
  "relation": "追慕",
  "quote": "庭中石筍，有黃魯直建中靖國元年題字。",
  "quote_source": "入蜀記标点本（維基文庫）",
  "book": "w-ru-shu-ji",
  "note": ""
 },
 {
  "id": "int-069",
  "source_table": "events",
  "source_id": "WCL-001",
  "target_person_id": "p-du-fu",
  "target_name": "杜甫",
  "relation": "追慕",
  "quote": "杜子美詩曰：「門泊東吳萬里船。」此橋正為吳人設。",
  "quote_source": "吳船錄标点本（維基文庫）",
  "book": "w-wu-chuan-lu",
  "note": ""
 },
 {
  "id": "int-070",
  "source_table": "events",
  "source_id": "WCL-001",
  "target_person_id": "p-zhuge-liang",
  "target_name": "諸葛亮",
  "relation": "追慕",
  "quote": "諸葛孔明送費祎使吳，曰：「萬里之行，始於此。」後因以名橋。",
  "quote_source": "吳船錄标点本（維基文庫）",
  "book": "w-wu-chuan-lu",
  "note": ""
 },
 {
  "id": "int-071",
  "source_table": "events",
  "source_id": "WCL-002",
  "target_person_id": "p-du-fu",
  "target_name": "杜甫",
  "relation": "追慕",
  "quote": "杜子美詩：「南京犀浦道，四月熟黃梅。湛湛長江去，冥冥細雨來。」蜀無梅雨，子美梅熟時經行，偶值雨耳。",
  "quote_source": "吳船錄标点本（維基文庫）",
  "book": "w-wu-chuan-lu",
  "note": ""
 },
 {
  "id": "int-072",
  "source_table": "events",
  "source_id": "WCL-002",
  "target_person_id": "p-du-fu",
  "target_name": "杜甫",
  "relation": "追慕",
  "quote": "杜子美詩：「南京犀浦道，四月熟黃梅。湛湛長江去，冥冥細雨來。」蜀無梅雨，子美梅熟時經行，偶值雨耳。",
  "quote_source": "吳船錄标点本（維基文庫）",
  "book": "w-wu-chuan-lu",
  "note": ""
 },
 {
  "id": "int-073",
  "source_table": "events",
  "source_id": "WCL-004",
  "target_person_id": "p-du-fu",
  "target_name": "杜甫",
  "relation": "纪其遗迹",
  "quote": "取杜子美詩「玉壘浮雲變古今」之句，登臨雄勝。",
  "quote_source": "吳船錄标点本（維基文庫）",
  "book": "w-wu-chuan-lu",
  "note": ""
 },
 {
  "id": "int-074",
  "source_table": "events",
  "source_id": "WCL-010",
  "target_person_id": "p-huang-ti",
  "target_name": "黃庭堅",
  "relation": "追慕",
  "quote": "山谷所跋者，其末句譽天地之高厚，贊日月之光華；「臣知其不能也」，今集中作「臣自知其不能也」。",
  "quote_source": "吳船錄标点本（維基文庫）",
  "book": "w-wu-chuan-lu",
  "note": ""
 },
 {
  "id": "int-075",
  "source_table": "events",
  "source_id": "WCL-010",
  "target_person_id": "p-huang-ti",
  "target_name": "黃庭堅",
  "relation": "追慕",
  "quote": "山谷自稱「洪州分寧縣雙井里前史官臣黃庭堅」，蓋謫戎州時所跋。",
  "quote_source": "吳船錄标点本（維基文庫）",
  "book": "w-wu-chuan-lu",
  "note": ""
 },
 {
  "id": "int-076",
  "source_table": "events",
  "source_id": "WCL-012",
  "target_person_id": "p-du-fu",
  "target_name": "杜甫",
  "relation": "追慕",
  "quote": "杜子美所謂「西川供客眼，惟有此江郊」。",
  "quote_source": "吳船錄标点本（維基文庫）",
  "book": "w-wu-chuan-lu",
  "note": ""
 },
 {
  "id": "int-077",
  "source_table": "events",
  "source_id": "WCL-013",
  "target_person_id": "p-su-shi",
  "target_name": "蘇軾",
  "relation": "纪其遗迹",
  "quote": "劉焞文潛招集於郡圃起文堂，堂名蓋為東坡設對起文。",
  "quote_source": "吳船錄标点本（維基文庫）",
  "book": "w-wu-chuan-lu",
  "note": "「東坡」此處為黃州地名（蘇軾舊居），紀其遺跡"
 },
 {
  "id": "int-078",
  "source_table": "events",
  "source_id": "WCL-015",
  "target_person_id": "p-huang-ti",
  "target_name": "黃庭堅",
  "relation": "纪其遗迹",
  "quote": "凡山中巖潭亭院之榜，皆山谷書。",
  "quote_source": "吳船錄标点本（維基文庫）",
  "book": "w-wu-chuan-lu",
  "note": ""
 },
 {
  "id": "int-079",
  "source_table": "events",
  "source_id": "WCL-015",
  "target_person_id": "p-huang-ti",
  "target_name": "黃庭堅",
  "relation": "追慕",
  "quote": "山谷貶戎州，今敘州也。",
  "quote_source": "吳船錄标点本（維基文庫）",
  "book": "w-wu-chuan-lu",
  "note": ""
 },
 {
  "id": "int-080",
  "source_table": "events",
  "source_id": "WCL-018",
  "target_person_id": "p-su-shi",
  "target_name": "蘇軾",
  "relation": "纪其遗迹",
  "quote": "東坡詩：「但願身為漢嘉守，載酒常作淩雲遊。」後人取其語，作載酒亭於山上。",
  "quote_source": "吳船錄标点本（維基文庫）",
  "book": "w-wu-chuan-lu",
  "note": "「東坡」此處為黃州地名（蘇軾舊居），紀其遺跡"
 },
 {
  "id": "int-081",
  "source_table": "events",
  "source_id": "WCL-019",
  "target_person_id": "p-huang-ti",
  "target_name": "黃庭堅",
  "relation": "追慕",
  "quote": "山谷常遊之，名軒曰涪翁，壁間題字猶存。",
  "quote_source": "吳船錄标点本（維基文庫）",
  "book": "w-wu-chuan-lu",
  "note": ""
 },
 {
  "id": "int-082",
  "source_table": "events",
  "source_id": "WCL-019",
  "target_person_id": "p-huang-ti",
  "target_name": "黃庭堅",
  "relation": "追慕",
  "quote": "是時未有萬景，故山谷以安樂園為勝，今不足道矣。",
  "quote_source": "吳船錄标点本（維基文庫）",
  "book": "w-wu-chuan-lu",
  "note": ""
 },
 {
  "id": "int-083",
  "source_table": "events",
  "source_id": "WCL-019",
  "target_person_id": "p-huang-ti",
  "target_name": "黃庭堅",
  "relation": "纪其遗迹",
  "quote": "舊名東丁水，寺亦因名東丁院，山谷更名方響洞，題詩云：「古人名此東丁水，自古丁東直到今。我為更名方響洞，要知山水有清音。」",
  "quote_source": "吳船錄标点本（維基文庫）",
  "book": "w-wu-chuan-lu",
  "note": ""
 },
 {
  "id": "int-084",
  "source_table": "events",
  "source_id": "WCL-032",
  "target_person_id": "p-du-fu",
  "target_name": "杜甫",
  "relation": "纪其遗迹",
  "quote": "郡醞舊名「重碧」，取杜子美《戎州》詩「重碧拈春酒，輕紅擘荔枝」之句。",
  "quote_source": "吳船錄标点本（維基文庫）",
  "book": "w-wu-chuan-lu",
  "note": ""
 },
 {
  "id": "int-085",
  "source_table": "events",
  "source_id": "WCL-032",
  "target_person_id": "p-huang-ti",
  "target_name": "黃庭堅",
  "relation": "追慕",
  "quote": "山谷謫居在小寺中，號大死庵。",
  "quote_source": "吳船錄标点本（維基文庫）",
  "book": "w-wu-chuan-lu",
  "note": ""
 },
 {
  "id": "int-086",
  "source_table": "events",
  "source_id": "WCL-032",
  "target_person_id": "p-huang-ti",
  "target_name": "黃庭堅",
  "relation": "纪其遗迹",
  "quote": "方山谷謫居時，屢有鎖江亭詩，今江上舊基，別作新亭，頗如法鎖江者。",
  "quote_source": "吳船錄标点本（維基文庫）",
  "book": "w-wu-chuan-lu",
  "note": ""
 },
 {
  "id": "int-087",
  "source_table": "events",
  "source_id": "WCL-033",
  "target_person_id": "p-zhuge-liang",
  "target_name": "諸葛亮",
  "relation": "纪其遗迹",
  "quote": "近城有渡瀘亭，竟不知諸葛孔明的從何處渡。",
  "quote_source": "吳船錄标点本（維基文庫）",
  "book": "w-wu-chuan-lu",
  "note": ""
 },
 {
  "id": "int-088",
  "source_table": "events",
  "source_id": "WCL-041",
  "target_person_id": "p-bai-juyi",
  "target_name": "白居易",
  "relation": "纪其遗迹",
  "quote": "有四賢閣，繪劉晏、陸贄、李吉甫、白居易像，皆嘗謫此州者。",
  "quote_source": "吳船錄标点本（維基文庫）",
  "book": "w-wu-chuan-lu",
  "note": ""
 },
 {
  "id": "int-089",
  "source_table": "events",
  "source_id": "WCL-041",
  "target_person_id": "p-bai-juyi",
  "target_name": "白居易",
  "relation": "追慕",
  "quote": "又有荔枝樓，樂天所作。",
  "quote_source": "吳船錄标点本（維基文庫）",
  "book": "w-wu-chuan-lu",
  "note": ""
 },
 {
  "id": "int-090",
  "source_table": "events",
  "source_id": "WCL-042",
  "target_person_id": "p-huang-ti",
  "target_name": "黃庭堅",
  "relation": "追慕",
  "quote": "山谷題字極稱許之。",
  "quote_source": "吳船錄标点本（維基文庫）",
  "book": "w-wu-chuan-lu",
  "note": ""
 },
 {
  "id": "int-091",
  "source_table": "events",
  "source_id": "WCL-044",
  "target_person_id": "p-du-fu",
  "target_name": "杜甫",
  "relation": "追慕",
  "quote": "高齋雖未必是杜子美所賦，然下臨灩滪，亦奇觀也。",
  "quote_source": "吳船錄标点本（維基文庫）",
  "book": "w-wu-chuan-lu",
  "note": ""
 },
 {
  "id": "int-092",
  "source_table": "events",
  "source_id": "WCL-047",
  "target_person_id": "p-du-fu",
  "target_name": "杜甫",
  "relation": "纪其遗迹",
  "quote": "杜子美詩云：「宋玉悲秋宅。」謂此縣傍有酒壚，或為題作「宋玉東家」。",
  "quote_source": "吳船錄标点本（維基文庫）",
  "book": "w-wu-chuan-lu",
  "note": ""
 },
 {
  "id": "int-093",
  "source_table": "events",
  "source_id": "WCL-054",
  "target_person_id": "p-su-shi",
  "target_name": "蘇軾",
  "relation": "纪其遗迹",
  "quote": "廟門兩石馬，一馬缺一耳，東坡所書歐陽公夢記及詩甚詳。",
  "quote_source": "吳船錄标点本（維基文庫）",
  "book": "w-wu-chuan-lu",
  "note": ""
 },
 {
  "id": "int-094",
  "source_table": "events",
  "source_id": "WCL-055",
  "target_person_id": "p-huang-ti",
  "target_name": "黃庭堅",
  "relation": "纪其遗迹",
  "quote": "州宅有楚塞樓，山谷所名。",
  "quote_source": "吳船錄标点本（維基文庫）",
  "book": "w-wu-chuan-lu",
  "note": ""
 },
 {
  "id": "int-095",
  "source_table": "events",
  "source_id": "WCL-073",
  "target_person_id": "p-su-shi",
  "target_name": "蘇軾",
  "relation": "追慕",
  "quote": "未見所謂「亂石穿空」及「蒙茸」、「巉巖」之境，東坡詞賦微誇焉。",
  "quote_source": "吳船錄标点本（維基文庫）",
  "book": "w-wu-chuan-lu",
  "note": "「東坡」此處為黃州地名（蘇軾舊居），紀其遺跡"
 },
 {
  "id": "int-096",
  "source_table": "events",
  "source_id": "WCL-073",
  "target_person_id": "p-su-shi",
  "target_name": "蘇軾",
  "relation": "纪其遗迹",
  "quote": "郡將招集東坡雪堂。",
  "quote_source": "吳船錄标点本（維基文庫）",
  "book": "w-wu-chuan-lu",
  "note": "「東坡」此處為黃州地名（蘇軾舊居），紀其遺跡"
 },
 {
  "id": "int-097",
  "source_table": "events",
  "source_id": "WCL-073",
  "target_person_id": "p-su-shi",
  "target_name": "蘇軾",
  "relation": "追慕",
  "quote": "東坡卜居時，是亦有取於風水之說。",
  "quote_source": "吳船錄标点本（維基文庫）",
  "book": "w-wu-chuan-lu",
  "note": "「東坡」此處為黃州地名（蘇軾舊居），紀其遺跡"
 },
 {
  "id": "int-098",
  "source_table": "events",
  "source_id": "WCL-073",
  "target_person_id": "p-su-shi",
  "target_name": "蘇軾",
  "relation": "纪其遗迹",
  "quote": "堂東小屋，榜曰東坡，堂前橋亭曰小橋，皆後人旁緣命之。",
  "quote_source": "吳船錄标点本（維基文庫）",
  "book": "w-wu-chuan-lu",
  "note": "「東坡」此處為黃州地名（蘇軾舊居），紀其遺跡"
 },
 {
  "id": "int-099",
  "source_table": "events",
  "source_id": "WCL-078",
  "target_person_id": "p-bai-juyi",
  "target_name": "白居易",
  "relation": "纪其遗迹",
  "quote": "寺東北隅有新作白樂天草堂。",
  "quote_source": "吳船錄标点本（維基文庫）",
  "book": "w-wu-chuan-lu",
  "note": ""
 },
 {
  "id": "int-100",
  "source_table": "events",
  "source_id": "WCL-078",
  "target_person_id": "p-bai-juyi",
  "target_name": "白居易",
  "relation": "纪其遗迹",
  "quote": "樂天元和十年為州司馬，作堂香爐峰北遺愛寺南，往來遊處焉。",
  "quote_source": "吳船錄标点本（維基文庫）",
  "book": "w-wu-chuan-lu",
  "note": ""
 },
 {
  "id": "int-101",
  "source_table": "events",
  "source_id": "WCL-078",
  "target_person_id": "p-yu-yan",
  "target_name": "顏真卿",
  "relation": "追慕",
  "quote": "顏魯公題碑之兩側，略云：永泰丙午，真卿佐吉州。",
  "quote_source": "吳船錄标点本（維基文庫）",
  "book": "w-wu-chuan-lu",
  "note": ""
 },
 {
  "id": "int-102",
  "source_table": "events",
  "source_id": "WCL-078",
  "target_person_id": "p-yu-yan",
  "target_name": "顏真卿",
  "relation": "追慕",
  "quote": "顏魯公題其碑額之上，亦以永泰丙午歲遊東林時來。",
  "quote_source": "吳船錄标点本（維基文庫）",
  "book": "w-wu-chuan-lu",
  "note": ""
 }
]